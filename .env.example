# Database Configuration (SQLite default for dev, PostgreSQL for production/Docker)
DATABASE_URL=sqlite:///qa_results.db

# PostgreSQL Example:
# DATABASE_URL=postgresql+psycopg2://qa_user:<REPLACE_WITH_STRONG_PASSWORD>@localhost:5432/qa_operator

POSTGRES_DB=qa_operator
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>

# Security Configuration
ENVIRONMENT=development
API_KEY=
REQUIRE_API_KEY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
TRUST_PROXIES=false
TRUSTED_PROXIES=127.0.0.1,::1,testclient

# Optional Notification Configuration
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
REPORT_BASE_URL=

# Generative AI Insights Configuration (Optional - Disabled by Default)
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
