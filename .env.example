# Database Configuration (SQLite default for dev, PostgreSQL for production/Docker)
# SQLite Example:
# DATABASE_URL=sqlite:///qa_results.db

# PostgreSQL Example:
DATABASE_URL=postgresql+psycopg2://qa_user:change_me@localhost:5432/qa_operator

POSTGRES_DB=qa_operator
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=change_me

# Optional Notification Configuration
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
REPORT_BASE_URL=
